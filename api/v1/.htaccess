# ==============================================
# QR MENÜ - API v1 HTACCESS
# ==============================================
# Tüm /api/v1/* isteklerini index.php'ye yönlendirir.
# Örnek: GET /api/v1/menu/firma → index.php
# ==============================================

Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    # XAMPP: /LokmaQR/api/v1/  |  Hosting: /api/v1/
    RewriteBase /LokmaQR/api/v1/

    # Apache'nin Authorization başlığını PHP'ye iletmesi için (XAMPP dahil)
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Mevcut dosya/dizin ise doğrudan sun (index.php, auth.php, vb.)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    # Geri kalan tüm istekleri index.php'ye yönlendir
    RewriteRule ^(.*)$ index.php [QSA,L]
</IfModule>

# PHP ayarları — JSON çıktısını korumak için
php_flag display_errors Off
php_flag log_errors On

# CORS başlıkları — API için tüm kaynaklara izin ver
<IfModule mod_headers.c>
    Header always set Access-Control-Allow-Origin "*"
    Header always set Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
    Header always set Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With, X-API-Key"
    Header always set Access-Control-Max-Age "86400"
</IfModule>