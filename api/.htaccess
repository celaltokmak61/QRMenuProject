# ==============================================
# QR MENÜ - API DİZİN HTACCESS
# ==============================================
# /api/* isteklerini doğru alt dizine yönlendirir.
# ==============================================

Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /api/

    # Mevcut dosya/dizinse doğrudan sun
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # /api/v1/* → api/v1/ dizinine yönlendir (kendi .htaccess'i devralır)
    RewriteRule ^v1/(.*)$ v1/$1 [L]
</IfModule>

# PHP ayarları — JSON çıktısını korumak için
php_flag display_errors Off
php_flag log_errors On

# CORS başlıkları
<IfModule mod_headers.c>
    Header always set Access-Control-Allow-Origin "*"
    Header always set Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
    Header always set Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With, X-API-Key"
</IfModule>